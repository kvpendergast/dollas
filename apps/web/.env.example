# Local app role. Startup migrations prefer DATABASE_URL_UNPOOLED, then this URL.
# The local app role cannot change the schema; use pnpm db:migrate for that.
DATABASE_URL=postgresql://dollas_app:dollas@127.0.0.1:5432/dollas
# Local table owner. Used by pnpm db:migrate and pnpm db:seed, not by Vercel startup.
DATABASE_MIGRATE_URL=postgresql://dollas:dollas@127.0.0.1:5432/dollas
BETTER_AUTH_URL=http://localhost:3000
# Optional. When unset, local dev uses a built-in development secret.
# Production must set BETTER_AUTH_SECRET in the host. Do not commit a value.
# BETTER_AUTH_SECRET=
# Optional Google sign-in. Leave unset for seed-data local dev.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Verification email. Set both to send links through Resend.
# When both are unset, local development writes the link to the server log.
# Production and preview set both on Vercel. The API key stays in RESEND_API_KEY there, not in this repo.
# RESEND_FROM on those environments is noreply@dollas.kylependergast.com.
# RESEND_API_KEY=
# RESEND_FROM=noreply@dollas.kylependergast.com
# Encrypts bank connection tokens at rest (AES-256-GCM). Required to start the app and to seed.
# Comma-separated version:base64 entries. Each value is 32 bytes. The highest version
# encrypts new tokens; leave older versions in the list so existing tokens still decrypt.
# Generate a local key (do not commit it):
#   node -e "console.log('1:' + require('node:crypto').randomBytes(32).toString('base64'))"
# BANK_CONNECTION_KEYS=
# Vercel + Neon inject DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED (direct).
# Those logins own the tables. Startup migrates with DATABASE_URL_UNPOOLED, or DATABASE_URL if that is unset.
# Household queries assume dollas_app inside the transaction, so row-level security applies.
# DATABASE_MIGRATE_URL is not required on Vercel. Do not commit a connection string.
