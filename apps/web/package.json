{
  "name": "@dollas/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/db/*.test.ts src/lib/*.test.ts src/slices/activity/*.test.ts src/slices/agents/*.test.ts src/slices/auth/*.test.ts src/slices/books/*.test.ts src/slices/connections/*.test.ts src/slices/household/*.test.ts src/slices/onboarding/*.test.ts src/slices/recurring/*.test.ts src/slices/settings/*.test.ts src/slices/spending/*.test.ts && vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "mcp:local": "tsx scripts/mcp-local.ts",
    "smoke:viewport": "tsx scripts/viewport-smoke.ts"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.6",
    "@dollas/domain": "workspace:*",
    "@dollas/mcp": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^0.544.0",
    "next": "16.3.7",
    "postgres": "^3.4.7",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.31.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
