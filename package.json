{
  "name": "dollas",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @dollas/web dev",
    "build": "pnpm --filter @dollas/web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:migrate": "pnpm --filter @dollas/web db:migrate",
    "db:seed": "pnpm --filter @dollas/web db:seed"
  }
}
