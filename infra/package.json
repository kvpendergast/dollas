    "adopt-env": "ts-node --transpile-only scripts/adopt-env.ts"
  },
  "dependencies": {
    "@pulumi/pulumi": "3.267.0",
    "@pulumi/random": "4.21.2",
    "@pulumiverse/vercel": "5.4.1",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
